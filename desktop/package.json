{
  "name": "devprompt-desktop",
  "private": true,
  "version": "0.2.0",
  "description": "DevPrompt AI 桌面壳（Electron + Python sidecar，Windows / macOS / Linux）",
  "license": "MIT",
  "packageManager": "pnpm@10.15.0",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "start": "pnpm build && electron .",
    "dist": "electron-builder --publish never",
    "dist:dir": "electron-builder --dir --publish never"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  }
}
