  "defects": [
    {
      "defect_id": "D-01",
      "priority": "P1",
      "title": "Trace 多轮事件台账按全局 seq 排序，轮次交错",
      "impact": "同一会话两轮以上时，事件列表把 turn0/turn1 交错返回；按 seq 分页的轮次顺序不稳定，人类回溯体验下降。",
      "reproduction": "uv run pytest tests/e2e/obs/test_obs_trace.py::test_tr04_multi_turn_pagination_is_turn_major -q",
      "recommendation": "query_events 改为 ORDER BY turn_index, seq；cursor 改为 (turn_index, seq) 复合游标，并同步调整 API 契约与前端加载更早逻辑。",
      "status": "open（仅报告）"
    },
    {
      "defect_id": "D-02",
      "priority": "P0",
      "title": "trace.write_failed 未登记事件名，写失败时二次抛错破坏 fail-open",
      "impact": "TraceCollectorImpl.flush 的异常分支调用 emit('trace.write_failed')，该事件不在 EVENT_NAMES，emit 抛 ValueError；当缓冲区在轮次中途写满时异常穿透到业务，Trace 写失败会直接导致本轮优化失败。",
      "reproduction": "uv run pytest tests/e2e/obs/test_obs_resilience.py::test_ab06_trace_write_failure_keeps_business -q",
      "recommendation": "① 在 observability/logging.EVENT_NAMES 登记 trace.write_failed；② flush 的 except 分支整体 try/except 包裹 emit，确保观测失败永不外抛。",
      "status": "open（仅报告）"
    },
    {
      "defect_id": "D-03",
      "priority": "P1",
      "title": "并发告警评估触发唯一索引冲突",
      "impact": "MetricsService.evaluate 并发（多轮/多会话同时结束）时，sync_alerts 先查后插无事务保护，触发 metrics_alerts 唯一索引 IntegrityError。",
      "reproduction": "uv run pytest tests/e2e/obs/test_obs_metrics.py::test_mt04_concurrent_evaluation_is_idempotent -q",
      "recommendation": "sync_alerts 使用 BEGIN IMMEDIATE 单事务 + INSERT ... ON CONFLICT DO UPDATE，或对同一 scope 加进程内串行锁。",
      "status": "open（仅报告）"
    },
    {
      "defect_id": "D-04",
      "priority": "P0",
      "title": "POST /runs 不接受前端新生成的 session_id，新会话直接 6003",
      "impact": "前端 OptimizePage 在新会话时用 crypto.randomUUID() 生成 session_id 并 POST /runs；RunManager 交给 service.optimize(start_turn) 时该会话不存在，返回 6003（流程 ID 不存在），新会话无法通过多端运行协议启动。本次真实场景改用测试预建会话才跑通。",
      "reproduction": "用任意新 UUID POST /api/v1/runs 后订阅 /sessions/{id}/stream：第二条事件即为 error code=6003。",
      "recommendation": "RunManager.start 在会话不存在时创建容器（或新增 POST /sessions 供前端先建会话），并补充新会话经 /runs 启动的回归用例。",
      "status": "open（仅报告）"
    },
    {
      "defect_id": "D-06",
      "priority": "P1",
