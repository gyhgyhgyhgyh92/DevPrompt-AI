          "kind_counts"
        ],
        "title": "ScanResponse",
        "type": "object"
      },
      "SettingsResponse": {
        "description": "GET/PUT /settings 数据体（T6-11）。",
        "properties": {
          "locked": {
            "$ref": "#/components/schemas/LockedSettings"
          },
          "model_service": {
            "$ref": "#/components/schemas/ModelServiceSettings"
          },
          "process": {
            "$ref": "#/components/schemas/ProcessSettings"
          }
        },
        "required": [
          "model_service",
          "process",
          "locked"
        ],
        "title": "SettingsResponse",
        "type": "object"
      },
      "SettingsUpdate": {
        "description": "PUT /settings 请求体（T6-11）。",
        "properties": {
          "model_service": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ModelServiceUpdate"
              },
              {
                "type": "null"
              }
            ]
          },
          "process": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProcessUpdate"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "SettingsUpdate",
        "type": "object"
      },
      "SymbolPayload": {
        "description": "目标定位（上下文面板，设计 §1.2）：symbol@path:line。",
        "properties": {
          "line": {
            "default": 0,
            "title": "Line",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "path": {
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "name",
          "path"
        ],
        "title": "SymbolPayload",
        "type": "object"
      },
      "UnknownItemPayload": {
        "description": "domain UnknownItem 的契约镜像（仅渲染字段）。",
        "properties": {
          "ask": {
            "title": "Ask",
            "type": "string"
          },
          "best_guess": {
            "title": "Best Guess",
            "type": "string"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "key",
          "reason",
          "best_guess",
          "ask"
        ],
        "title": "UnknownItemPayload",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VariantPayload": {
        "description": "domain VariantDraft 的契约镜像（F-301 结构化方案）。",
        "properties": {
          "body": {
            "title": "Body",
            "type": "string"
          },
          "changes": {
            "items": {
              "type": "string"
            },
            "title": "Changes",
            "type": "array"
          },
          "level": {
            "title": "Level",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "body",
          "level"
        ],
        "title": "VariantPayload",
        "type": "object"
      }
    }
  },
