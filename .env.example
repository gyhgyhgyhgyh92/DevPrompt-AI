# ===== LLM 供应商（必填）=====
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-chat

# ===== 推荐与阈值 =====
PREFER_ADAPT_WEIGHT=0.6
PREFER_HISTORY_WEIGHT=0.4
PREFER_HARD_THRESHOLD=0.5
PREFER_SOFT_THRESHOLD=0.12
PREFER_MIN_CONFIDENCE=0.6
PREFER_LOW_CONFIDENCE=0.4

# ===== 流程控制 =====
FOLLOWUP_SOFT_ROUND_GUARD=10
# 单流程 LLM token 总数上限；0 = 禁用成本软护栏（MUST-26）。
# 结构推导：轮次护栏 10 × 单轮 token 上界 5000 = 50000（上界取实测 p95 向上取整）。
# 定位是成本异常时的兜底闸：正常多轮累计仍在阈值内，只有单轮异常膨胀才会先撞线。
FOLLOWUP_COST_BUDGET=50000
FACT_PROBE_THRESHOLD=0.75
MAX_STATE_TOKENS=30000

# ===== 运行时 =====
APP_ENV=dev
LOG_LEVEL=INFO
LOG_DIR=./.logs
DATA_DIR=~/.devprompt-ai
CORS_ORIGINS=http://localhost:5173

# ===== 存储（SQLite 单文件，WAL）=====
DB_PATH=~/.devprompt-ai/devprompt.db

# ===== Reflection 经验库（可选，默认关闭）=====
# 需要本地 agentmemory 侧车：npx -y @agentmemory/agentmemory@latest（Node >= 20）
# 侧车不可用时整条链路静默跳过，不影响生成。
REFLECTION_ENABLED=false
REFLECTION_BASE_URL=http://127.0.0.1:3111
# agentmemory 首次启动自动生成该密钥文件（0600），不要把内容写进任何配置文件。
REFLECTION_SECRET_PATH=~/.agentmemory/secret
# 桶前缀：项目桶 <前缀>-proj-<hash>，全局桶 <前缀>-global
REFLECTION_AGENT_ID=devprompt
REFLECTION_TOP_K=5
REFLECTION_MAX_CHARS=1200
REFLECTION_TIMEOUT_SECONDS=3.0
