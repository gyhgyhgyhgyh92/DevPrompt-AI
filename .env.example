# ===== LLM 供应商（必填）=====
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-chat

# ===== Jev 决策层（可选，缺失自动降级 LLM）=====
TYPESAFE_API_KEY=
JEV_MODEL_ID=jev-1.13.0

# ===== 推荐与阈值 =====
PREFER_ADAPT_WEIGHT=0.6
PREFER_HISTORY_WEIGHT=0.4
PREFER_HARD_THRESHOLD=0.5
PREFER_SOFT_THRESHOLD=0.12
PREFER_MIN_CONFIDENCE=0.6
PREFER_LOW_CONFIDENCE=0.4

# ===== 流程控制 =====
MAX_FOLLOWUP_ROUNDS=2
FACT_PROBE_THRESHOLD=0.75
MAX_STATE_TOKENS=30000
DECIDER=auto

# ===== 运行时 =====
APP_ENV=dev
LOG_LEVEL=INFO
LOG_DIR=./.logs
DATA_DIR=~/.devprompt-ai
CORS_ORIGINS=http://localhost:5173

# ===== MySQL 存储（L1/L3，必填）=====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=devprompt
MYSQL_PASSWORD=change-me
MYSQL_DB=devprompt_ai
MYSQL_POOL_SIZE=5
